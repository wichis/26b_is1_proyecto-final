@startuml
!pragma layout smetana
title M9 - Disponibilidad de edición de requisitos (UC02)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam ArrowColor #444444
skinparam actorBorderColor #1F3B57
skinparam actorBackgroundColor #FFFFFF
skinparam participantBackgroundColor #EAF2FB
skinparam participantBorderColor #2F5D8A
skinparam boundaryBackgroundColor #EAF2FB
skinparam boundaryBorderColor #2F5D8A
skinparam controlBackgroundColor #EAF2FB
skinparam controlBorderColor #2F5D8A
skinparam databaseBackgroundColor #F9E79F
skinparam databaseBorderColor #8A6D1F
skinparam componentBackgroundColor #EAF2FB
skinparam componentBorderColor #2F5D8A
skinparam interfaceBackgroundColor #FFFFFF
skinparam interfaceBorderColor #1F3B57
skinparam packageBorderColor #1F3B57
skinparam activityBackgroundColor #EAF2FB
skinparam activityBorderColor #2F5D8A
skinparam activityDiamondBackgroundColor #FFF0CC
skinparam activityDiamondBorderColor #B7791F
skinparam swimlaneTitleFontStyle bold
skinparam sequenceGroupBackgroundColor #FFF0CC
skinparam sequenceGroupBorderColor #B7791F
skinparam stateBackgroundColor #EAF2FB
skinparam stateBorderColor #2F5D8A
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EAF2FB
skinparam classBorderColor #2F5D8A
skinparam noteBackgroundColor #FFF7E6
skinparam noteBorderColor #B7791F
state "Editables" as Editables
state "Bloqueados" as Bloqueados
[*] --> Editables : registrar tipo de examen
Editables --> Editables : modificar requisitos [sin exámenes pendientes]
Editables --> Bloqueados : Calendario programa un examen del tipo
Bloqueados --> Editables : aplicar examen [no quedan exámenes pendientes]
note right of Bloqueados
  No se permite modificar requisitos
  mientras exista al menos un examen pendiente.
end note
note bottom of Editables
  Condición derivada de los exámenes programados;
  no es un estado persistente de un requisito individual.
  Aplica al conjunto de requisitos de TipoExamen (UC02).
end note
@enduml
