@startuml
title Diagrama de secuencia - UC1 Registrar profesor

actor "Administrador escolar" as Admin
participant "Módulo Profesores" as UI
participant ProfesorController
participant ProfesorService
database "Base de datos" as BD

Admin -> UI : Selecciona "Registrar profesor"
UI --> Admin : Muestra formulario de registro

alt Cancela el registro
  Admin -> UI : Presiona "Cancelar"
  UI -> UI : Descarta datos capturados
  UI --> Admin : Cierra el formulario y regresa a la pantalla anterior
  note right of UI : No se invoca al controlador ni a la BD,\nno se guarda nada.

else Intenta recargar la página antes de guardar
  Admin -> UI : Recarga la página
  UI --> Admin : Advierte "Hay datos sin guardar, ¿desea salir?"
  alt Confirma salir
    Admin -> UI : Confirma
    UI -> UI : Descarta datos capturados
    UI --> Admin : Muestra formulario vacío
  else Decide quedarse
    Admin -> UI : Cancela la recarga
    UI --> Admin : Conserva el formulario con los datos capturados
  end
  note right of UI : No se guardó nada en la BD.

else Captura datos y guarda
  Admin -> UI : Captura datos y presiona "Guardar"
  UI -> ProfesorController : registrarProfesor(datos)
  ProfesorController -> ProfesorService : validarDatos(datos)

  alt Datos inválidos o incompletos
    ProfesorService --> ProfesorController : Error de validación
    ProfesorController --> UI : Mensaje de error
    UI --> Admin : Muestra campos a corregir
  else Datos válidos
    ProfesorService -> BD : buscarProfesor(correo / número de empleado)
    BD --> ProfesorService : Resultado

    alt Profesor ya existe
      ProfesorService --> ProfesorController : Error: profesor duplicado
      ProfesorController --> UI : Mensaje de duplicado
      UI --> Admin : Informa que ya está registrado
      note right of UI : Si se recarga y reenvía el formulario\ndespués de guardar, cae aquí y no se\nregistra dos veces.
    else Profesor nuevo
      ProfesorService -> BD : guardarProfesor(datos)
      BD --> ProfesorService : Registro creado (id)
      ProfesorService --> ProfesorController : Registro exitoso
      ProfesorController --> UI : Confirmación
      UI --> Admin : "Profesor registrado correctamente"
    end
  end
end
@enduml