@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #42556A
skinparam BorderColor #42556A
skinparam dpi 150
skinparam roundcorner 8
skinparam sequence {
  ParticipantBackgroundColor #F1F4F7
  ParticipantBorderColor #42556A
  LifeLineBorderColor #7B8794
  ActorBorderColor #42556A
  GroupBackgroundColor #FAFBFC
  GroupHeaderFontColor #253746
}
skinparam activity {
  BackgroundColor #F1F4F7
  BorderColor #42556A
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #42556A
}
skinparam state {
  BackgroundColor #F1F4F7
  BorderColor #42556A
}
skinparam class {
  BackgroundColor #F1F4F7
  BorderColor #42556A
}

title UC3. Modificar datos del profesor: actividades

|Administrador escolar|
start
:Seleccionar profesor y enviar cambios;
|Módulo Profesores|
:Comprobar identidad y permiso de operación;
if (¿Acceso autorizado?) then (sí)
else (no)
 :Informar rechazo de acceso;
 stop
endif

:Obtener profesor seleccionado;
if (¿La consulta terminó correctamente?) then (sí)
else (no)
 :Informar que la consulta no está disponible;
 stop
endif

if (¿Existe el registro?) then (sí)
else (no)
 :Informar que no se encontró el profesor;
 stop
endif

:Validar campos permitidos y datos;
if (¿Cambios válidos y autorizados?) then (sí)
else (no)
 :Informar rechazo sin guardar;
 stop
endif

:Consultar duplicados excluyendo al profesor actual;
if (¿La consulta de duplicados terminó correctamente?) then (sí)
else (no)
 :Informar fallo de consulta sin guardar;
 stop
endif

if (¿Existe otra coincidencia?) then (sí)
 :Informar duplicado y rechazar cambios;
 stop
else (no)
endif
:Guardar cambios sin alterar el estado del registro;
if (¿Guardado confirmado?) then (sí)
 :Mostrar datos actualizados y confirmación;
else (no)
 :Informar fallo de actualización;
endif
stop
@enduml
