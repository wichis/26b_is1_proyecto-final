0; }

#ext-promo .ext-promo-text { flex: 1 1 0%; min-width: 240px; }

#ext-promo .ext-promo-links { display: flex; gap: 8px; flex-wrap: wrap; fle=
x-shrink: 0; }

#ext-promo .ext-promo-links a { display: inline-block; padding: 5px 12px; b=
order-radius: 4px; color: rgb(255, 255, 255); text-decoration: none; font-w=
eight: 500; font-size: 13px; white-space: nowrap; transition: background 0.=
15s; }

#ext-promo .ext-promo-links a.firefox:hover { background: rgb(166, 66, 0); =
}

#ext-promo .ext-promo-links a.chrome:hover { background: rgb(2, 80, 168); }
