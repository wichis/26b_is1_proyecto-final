#toc li:hover { background: rgb(254, 254, 254); }

#magic { position: absolute; top: 0px; right: 50px; width: 30px; height: 30=
px; overflow: hidden; background: rgb(237, 239, 243); z-index: 14; }

#magic:hover { width: calc(100% - 50px); }

#magic .menu1 { position: absolute; top: 0px; right: 30px; height: 30px; pa=
dding-left: 10px; background: rgb(237, 239, 243); border-left: 1px solid rg=
b(212, 216, 222); border-bottom: 1px solid rgb(212, 216, 222); }

#magic > img { position: absolute; top: 0px; right: 0px; width: 30px; heigh=
t: 30px; filter: brightness(0) saturate(100%) invert(42%) sepia(22%) satura=
te(385%) hue-rotate(170deg) brightness(92%) contrast(84%); }

#magic:hover > img { filter: brightness(0) saturate(100%) invert(23%) sepia=
(44%) saturate(7029%) hue-rotate(203deg) brightness(94%) contrast(98%); }

