.abgl { text-decoration: none; }

.abgs svg, .abgb svg { display: inline-block; height: 15px; width: auto; ve=
rtical-align: top; }

.abgc .il-wrap { background-color: rgb(255, 255, 255); height: 15px; white-=
space: nowrap; }

.abgc .il-wrap.exp { border-bottom-left-radius: 5px; }

