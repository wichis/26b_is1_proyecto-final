.tag, .tagg, .tago, .tagr { text-rendering: optimizelegibility; display: in=
line-block; padding: 3px 5px 2px 4px; text-decoration: none; white-space: n=
owrap; border: 1px solid rgb(153, 153, 153); text-transform: uppercase; tex=
t-align: center; border-radius: 3px; font-size: 11px; font-weight: bold; li=
ne-height: 90%; }

.tag { background-color: rgb(238, 238, 238); }

.tagg { background-color: rgb(152, 251, 152); }

.tago { background-color: rgb(250, 250, 0); }

.tagr { background-color: rgb(255, 69, 0); }

a { text-decoration: none; color: rgb(3, 102, 214); }

a:hover { text-decoration: underline; }

.menu1 { display: flex; flex-direction: row; border: 0px; font-size: 14px; =
padding: 0px; margin: 0px; white-space: nowrap; }

.menu1 a { white-space: nowrap; padding: 0px 8px; text-decoration: none; co=
lor: rgb(94, 109, 125); line-height: 30px; height: 30px; }

.menu1 a:hover { background: rgb(254, 254, 254); color: rgb(3, 102, 214); }

.menuside2 { display: flex; flex-direction: column; border: 0px; font-size:=
 14px; padding: 0px; margin: 0px; overflow: hidden; justify-content: center=
; }

.menuside2 img { vertical-align: top; padding: 0px 8px; filter: brightness(=
0) saturate(100%) invert(42%) sepia(22%) saturate(385%) hue-rotate(170deg) =
brightness(92%) contrast(84%); }

.menuside2 a { padding: 6px 0px; text-decoration: none; color: rgb(94, 109,=
 125); }

.menuside2 a:hover { color: rgb(3, 102, 214); background: rgb(254, 254, 254=
); }

.menuside2 a:hover img { filter: brightness(0) saturate(100%) invert(23%) s=
epia(44%) saturate(7029%) hue-rotate(203deg) brightness(94%) contrast(98%);=
 }

.breadcrumb { z-index: 1; font-size: 14px; text-align: center; display: inl=
ine-block; overflow: hidden; border-radius: 5px; }

.breadcrumb a { text-decoration: none; outline: none; display: block; float=
: left; font-size: 12px; line-height: 24px; color: rgb(55, 63, 73); padding=
: 0px 10px 0px 35px; background: linear-gradient(rgb(240, 241, 241), rgb(19=
8, 210, 210)); position: relative; }

.breadcrumb a:first-child { padding-left: 21px; border-radius: 5px 0px 0px =
5px; }

.breadcrumb a:first-child::before { left: 14px; }

.breadcrumb a:last-child { visibility: hidden; }

.breadcrumb a.active, .breadcrumb a:hover { color: rgb(3, 102, 214); backgr=
ound: linear-gradient(rgb(227, 228, 228), rgb(184, 199, 199)); }

.breadcrumb a.active::after, .breadcrumb a:hover::after { background: linea=
r-gradient(135deg, rgb(227, 228, 228), rgb(184, 199, 199)); }

.breadcrumb a::after { content: ""; position: absolute; top: 0px; right: -1=
2px; width: 24px; height: 24px; transform: scale(0.707) rotate(45deg); z-in=
dex: 1; background: linear-gradient(135deg, rgb(240, 241, 241), rgb(198, 21=
0, 210)); box-shadow: rgba(0, 0, 0, 0.1) 2px -2px 0px 2px, rgba(255, 255, 2=
55, 0.1) 3px -3px 0px 2px; border-radius: 0px 5px 0px 50px; }

.breadcrumb a:last-child::after { content: none; visibility: hidden; }

.lga, .lga a, .lgi, .lgi a { font-size: 13px; text-align: center; color: rg=
b(255, 255, 255); padding: 0px 5px; margin: 0px; }

.lga, .lga a { background-color: rgb(0, 0, 136); }

.lgi, .lgi a { background-color: rgb(136, 136, 136); }

.lga:hover, .lga:hover a { text-decoration: none; color: rgb(187, 187, 187)=
; }

.lgi:hover, .lgi:hover a { text-decoration: none; color: rgb(204, 204, 204)=
; }
