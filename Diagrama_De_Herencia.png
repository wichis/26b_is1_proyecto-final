44%) saturate(7029%) hue-rotate(203deg) brightness(94%) contrast(98%); }

.menu1-tail { flex-grow: 1; flex-shrink: 0; height: 30px; position: relativ=
e; z-index: 15; background: rgb(237, 239, 243); }

.grid { display: grid; grid-template-columns: auto auto auto; grid-auto-row=
s: auto; gap: 5px; margin: 0px; padding: 0px; }

.merged { grid-column: 1 / -1; }

.ezoic-wrap { display: block; overflow: hidden; }

#C6 { display: none; }

