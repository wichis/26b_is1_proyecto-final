rgb(221, 221, 221); box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 4px; font-family=
: monospace; font-size: 14px; background: rgb(254, 254, 254); color: rgb(36=
, 41, 46); }

.code3-container #out { flex: 1 1 0px; min-width: 0px; overflow: hidden; pa=
dding: 15px; border-radius: 10px; background: rgb(254, 254, 254); }

